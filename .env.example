# =============================================================================
# Blocksize Capital MCP Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Required on every hosted production and staging service. Hosted readiness
# deliberately fails closed unless the full production security policy applies.
APP_ENV=production
# Use the exact origin of this service. Staging must never inherit the
# production origin because manifests, x402 resources, and OAuth routes use it.
PUBLIC_BASE_URL=https://mcp.blocksize.info
# GitLab stamps this into the release artifact. For a direct Railway upload,
# set the exact 40-character commit SHA so hosted provenance can fail closed.
RELEASE_COMMIT_SHA=

# --- Blocksize Capital API ---
BLOCKSIZE_API_KEY=your_blocksize_api_key_here
BLOCKSIZE_BASE_URL=https://data.blocksize.capital/marketdata/v1

# --- Tiingo Equities API ---
TIINGO_API_KEY=your_tiingo_api_key_here
TIINGO_BASE_URL=https://api.tiingo.com/iex
TIINGO_EQUITY_BASE_URL=https://api.tiingo.com/tiingo/equity/intraday

# --- Blocksize websocket cache ---
# Enables true `/v1/vwap24h/{pair}` from fixedvwap_subscribe and warm state reads.
BLOCKSIZE_STREAM_CACHE_ENABLED=true
BLOCKSIZE_24H_CACHE_TICKERS=BTCUSD,ETHUSD,SOLUSD,JUPUSD,PYTHUSD
BLOCKSIZE_STATE_CACHE_TICKERS=MSOLUSD,JUPSOLUSD,WSTETHETH,WSTETHUSD
# Use `all` to subscribe to all state_instruments up to the max ticker cap.
BLOCKSIZE_STATE_CACHE_MODE=configured
BLOCKSIZE_STATE_CACHE_MAX_TICKERS=250
BLOCKSIZE_STREAM_CACHE_TTL_SECONDS=3600
BLOCKSIZE_STREAM_CACHE_RECONNECT_SECONDS=5

# --- x402 Payment — Solana (Primary) ---
# Your Solana wallet address to receive USDC payments
X402_SOLANA_WALLET_ADDRESS=YourSolanaWalletAddressHere

# Required for official x402 SVM clients. Copy the feePayer advertised for
# your exact network by the configured facilitator's /supported response.
# The Solana rail is not advertised when this value is missing or malformed.
X402_SOLANA_FEE_PAYER=

# Solana mainnet CAIP-2 identifier
X402_SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# USDC SPL Token address on Solana mainnet
X402_SOLANA_USDC_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- x402 Payment — Base L2 (Fallback) ---
# Your EVM wallet address to receive USDC on Base
X402_EVM_WALLET_ADDRESS=0xYourBaseWalletAddressHere

# Base mainnet CAIP-2 identifier
X402_BASE_NETWORK=eip155:8453

# USDC on Base mainnet
X402_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# EIP-712 domain metadata for native Base USDC (required by x402 clients)
X402_BASE_USDC_NAME=USD Coin
X402_BASE_USDC_VERSION=2

# --- Facilitator ---
# Configure a production-capable x402 v2 facilitator. The public x402.org
# facilitator is testnet/development-only and production readiness rejects it.
X402_FACILITATOR_URL=
# Readiness caches a bounded `/supported` probe and fails closed when it expires.
X402_FACILITATOR_READINESS_TIMEOUT_SECONDS=5
X402_FACILITATOR_READINESS_MAX_AGE_SECONDS=180
# Optional static bearer supported by self-hosted/generic facilitators. Prefer
# the provider's short-lived auth integration where available.
X402_FACILITATOR_BEARER_TOKEN=
# Required when X402_FACILITATOR_URL uses Coinbase's production CDP facilitator.
# The secret may be an Ed25519 base64 key or an ECDSA PEM key. Never commit it.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Chain RPC ---
# Use your own production RPC endpoints. Do not commit API-key URLs.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# --- RWA Growth Pilot (candidate monitoring only; never auto-promotes) ---
RWA_GROWTH_PILOT_ENABLED=false
RWA_GROWTH_PILOT_INTERVAL_SECONDS=1800
RWA_GROWTH_PILOT_STALE_AFTER_SECONDS=3900
RWA_GROWTH_PILOT_INITIAL_DELAY_SECONDS=15
RWA_GROWTH_PILOT_TIMEOUT_SECONDS=20

# Source-adapter controls retained for the block-pinned EVM pilot lanes.
RWA_EVM_RPC_MIN_INTERVAL_SECONDS=0.09
RWA_EVM_RPC_RETRY_ATTEMPTS=4
RWA_EVM_SWAP_CACHE_DIR=/data/rwa_evm_swap_cache
RWA_EVM_SWAP_CACHE_BOOTSTRAP_SECONDS=1800
# Primary authenticated RPCs for the Ethereum/Base pilot lanes.
EVM_RPC_ETHEREUM_URL=
EVM_RPC_BASE_URL=
# Optional comma-separated authenticated fallbacks, tried before public RPCs.
EVM_RPC_ETHEREUM_URLS=
EVM_RPC_BASE_URLS=
# Set true only when every required chain has redundant configured RPCs.
RWA_EVM_DISABLE_PUBLIC_RPC_FALLBACKS=false

# Operator-only RWA collection. Keep mutations disabled until the dedicated
# database and a generated secret (for example: openssl rand -hex 32) have
# passed /readyz. Never reuse a dashboard, API, or connector credential.
# Audited RWA runtime reports ship with the release. Set this only to replace
# the complete bundle; an explicit path is authoritative and never falls back.
RWA_REPORTS_DIR=
RWA_MUTATIONS_ENABLED=false
RWA_OPERATOR_TOKEN=
RWA_OBSERVATION_DB_PATH=/data/rwa_observations.v2.db
RWA_STORE_LOCK_TIMEOUT_SECONDS=1
RWA_PROBE_CALL_TIMEOUT_SECONDS=10
RWA_PROBE_TOTAL_TIMEOUT_SECONDS=30
RWA_PROBE_MAX_CONCURRENCY=2

# Reject proofs older than this many seconds. Set 0 only for controlled tests.
X402_PAYMENT_MAX_AGE_SECONDS=900
X402_PAYMENT_FUTURE_SKEW_SECONDS=30
X402_PAYMENT_MIN_CONFIRMATIONS=2
X402_PAYMENT_VERIFICATION_LEASE_SECONDS=120
# Bounded exactly-once response replay after a finalized payment.
X402_PAYMENT_REPLAY_TTL_SECONDS=3600
X402_PAYMENT_REPLAY_MAX_ENTRIES=500

# Keep false in production. True only accepts mock_ or test_ proofs for local demos.
X402_ALLOW_MOCK_PAYMENTS=false
# Legacy public transaction-hash proofs are not payer-bound. Keep disabled in
# production; official signed x402 v2 PAYMENT-SIGNATURE is the default.
X402_ALLOW_LEGACY_PAYMENTS=false

# --- Tiered Pricing (USDC per call) ---
# Discovery tools:          FREE
PRICE_CORE_CRYPTO=0.002
PRICE_EXTENDED_CRYPTO=0.004
PRICE_TRADFI=0.005
PRICE_EQUITIES=0.008
PRICE_ANALYTICS=0.008

# --- Server Configuration ---
# Railway routes the hosted service to port 8080. PORT takes precedence over
# RESOURCE_SERVER_PORT; the latter remains the local-development fallback.
PORT=8080
RESOURCE_SERVER_PORT=8402
MCP_TRANSPORT=stdio
MCP_SERVER_PORT=8403
LOG_LEVEL=INFO
# Direct local runs trust loopback only. The 2026-08-03 Railway staging run
# observed peer 100.64.0.2 and currently uses the bounded operational assumption
# FORWARDED_ALLOW_IPS=100.64.0.0/10. Railway does not publish a source-CIDR
# contract, so revalidate this in staging; never use "*" or a broad supernet.
FORWARDED_ALLOW_IPS=127.0.0.1
CORS_ALLOW_ORIGINS=https://mcp.blocksize.info,https://claude.ai,http://localhost:8402,http://127.0.0.1:8402
MAX_BATCH_SIZE=20
DISCOVERY_RATE_LIMIT_ENABLED=true
DISCOVERY_RATE_LIMIT_PER_MINUTE=60
DISCOVERY_RATE_LIMIT_PER_DAY=1000
# Raw X-AGENT-ID/X-USER-ID/wallet credit ownership is caller-controlled.
# Production uses authenticated MCP entitlements or signed x402 payments only.
UNVERIFIED_HTTP_CREDITS_ENABLED=false
CREDIT_DB_PATH=/data/credits.db
# Use a different generated value for every salt (`openssl rand -hex 32`).
# Production readiness rejects missing, reused-placeholder, or weak values.
TRIAL_IP_HASH_SALT=

# --- Product usage and marketplace attribution ---
OBSERVABILITY_ENABLED=true
OBSERVABILITY_DB_PATH=/data/usage_events.db
# Set a strong value in hosted environments; the collector sends it as a bearer token.
# Generate with `openssl rand -hex 32`; never place this value in a URL.
OBSERVABILITY_DASHBOARD_TOKEN=
# Privacy salts are independent so hashes cannot be correlated across purposes.
OBSERVABILITY_HASH_SALT=
RECEIPT_HASH_SALT=
RECEIPT_ID_SALT=
# Map onboarded platform ids to their authorized JSON metrics endpoints.
MARKETPLACE_METRICS_FEEDS_JSON={}
# Optional convenience aliases used by both the service and collector.
PAY_SH_METRICS_API_URL=
SMITHERY_METRICS_API_URL=
# Map platform ids to the NAME of an environment variable containing the feed token.
# Example: {"pay_sh":"PAY_SH_METRICS_TOKEN"}. Never place tokens in this JSON value.
MARKETPLACE_METRICS_TOKEN_ENVS_JSON={}
# Smithery's qualified server name, for example owner/server-name.
SMITHERY_QUALIFIED_NAME=
SMITHERY_API_KEY=

# --- Anthropic-safe MCP beta ---
# Mounts at /anthropic/mcp on the FastAPI resource server.
ANTHROPIC_ONLY_MODE=false
# Some clients, including Claude custom connectors, may fall back to root OAuth
# metadata even when connecting to a path-scoped MCP URL. Keep this set to
# anthropic on the shared production host; use cursor only on a Cursor-only host.
ROOT_OAUTH_CONNECTOR=anthropic
ANTHROPIC_DAILY_CREDITS=50
ANTHROPIC_ENTITLEMENT_DB_PATH=/data/anthropic_entitlements.db
# On staging, replace the origin with that service's STAGING_BASE_URL.
ANTHROPIC_MCP_PUBLIC_URL=https://mcp.blocksize.info/anthropic/mcp

# Use "none" for local development, or "clerk", "auth0", or "supabase" for OAuth.
ANTHROPIC_AUTH_PROVIDER=none
ANTHROPIC_ENABLE_BETA_TOKENS=false
ANTHROPIC_OAUTH_REDIRECT_PATH=/auth/callback
# Use a stable secret and persistent directory in production so Claude OAuth
# sessions survive deploys/restarts. Example on Railway: /data/anthropic_oauth.
ANTHROPIC_OAUTH_JWT_SIGNING_KEY=
ANTHROPIC_OAUTH_STORAGE_DIR=/data/anthropic_oauth
ANTHROPIC_OAUTH_STORAGE_ENCRYPTION_KEY=
ANTHROPIC_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*
ANTHROPIC_OAUTH_SCOPES=openid,email,profile

# Development/beta bearer-token map. Use only random secret tokens in real deployments.
ANTHROPIC_BETA_TOKENS='{"replace-with-random-token":{"user_id":"beta-user","email":"beta@example.com"}}'

# --- Cursor MCP connector ---
# Cursor uses its own entitlement settings so Claude storage changes do not move
# the Cursor daily-credit ledger.
CURSOR_DAILY_CREDITS=50
CURSOR_ENTITLEMENT_DB_PATH=/data/cursor_entitlements.db
# On staging, replace the origin with that service's STAGING_BASE_URL.
CURSOR_MCP_PUBLIC_URL=https://mcp.blocksize.info/cursor/mcp
CURSOR_AUTH_PROVIDER=none
CURSOR_ENABLE_BETA_TOKENS=false
CURSOR_OAUTH_REDIRECT_PATH=/auth/callback
CURSOR_OAUTH_JWT_SIGNING_KEY=
CURSOR_OAUTH_STORAGE_DIR=/data/cursor_oauth
CURSOR_OAUTH_STORAGE_ENCRYPTION_KEY=
CURSOR_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,cursor://*
CURSOR_OAUTH_SCOPES=email,profile
CURSOR_BETA_TOKENS=

# --- OpenAI / ChatGPT MCP connector ---
# ChatGPT supplies a connector-specific redirect URI during app setup. Add that
# exact URI to OPENAI_ALLOWED_CLIENT_REDIRECT_URIS in the hosted environment.
OPENAI_DAILY_CREDITS=50
OPENAI_ENTITLEMENT_DB_PATH=/data/openai_entitlements.db
# On staging, replace the origin with that service's STAGING_BASE_URL.
OPENAI_MCP_PUBLIC_URL=https://mcp.blocksize.info/openai/mcp
OPENAI_AUTH_PROVIDER=none
OPENAI_ENABLE_BETA_TOKENS=false
OPENAI_OAUTH_REDIRECT_PATH=/auth/callback
OPENAI_OAUTH_JWT_SIGNING_KEY=
OPENAI_OAUTH_STORAGE_DIR=/data/openai_oauth
OPENAI_OAUTH_STORAGE_ENCRYPTION_KEY=
OPENAI_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*
OPENAI_OAUTH_SCOPES=openid,email,profile,offline_access
OPENAI_BETA_TOKENS=

# Clerk OAuth option
CLERK_DOMAIN=
CLERK_CLIENT_ID=
CLERK_CLIENT_SECRET=

# Auth0 OAuth option
AUTH0_CONFIG_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Supabase OAuth option
SUPABASE_PROJECT_URL=

# --- Public CEX market-data streams ---
# Kraken spot symbols are dynamically verified against AssetPairs. Target
# xStocks must not be added unless they appear in the live Kraken catalog.
KRAKEN_SPOT_WS_SYMBOLS=BTC/USD,ETH/USD
KRAKEN_SPOT_WS_DEPTH=100
KRAKEN_XSTOCKS_WS_SYMBOLS=
KRAKEN_XSTOCKS_WS_DEPTH=100
CEX_STREAM_TTL_SECONDS=10

# Revolut X read-only market data. Keep the Ed25519 private key secret and use
# a multiline-capable secret store in hosted environments.
REVOLUT_X_API_KEY=
REVOLUT_X_PRIVATE_KEY_PEM=
