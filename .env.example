# =============================================================================
# Blocksize Capital MCP Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Blocksize Capital API ---
BLOCKSIZE_API_KEY=your_blocksize_api_key_here
BLOCKSIZE_BASE_URL=https://data.blocksize.capital/marketdata/v1

# --- Tiingo Equities API ---
TIINGO_API_KEY=your_tiingo_api_key_here
TIINGO_BASE_URL=https://api.tiingo.com/iex
TIINGO_EQUITY_BASE_URL=https://api.tiingo.com/tiingo/equity/intraday

# --- Blocksize websocket cache ---
# Enables true `/v1/vwap24h/{pair}` from fixedvwap_subscribe and warm state reads.
BLOCKSIZE_STREAM_CACHE_ENABLED=false
BLOCKSIZE_24H_CACHE_TICKERS=BTCUSD,ETHUSD,SOLUSD,JUPUSD,PYTHUSD
BLOCKSIZE_STATE_CACHE_TICKERS=MSOLUSD,JUPSOLUSD,WSTETHETH,WSTETHUSD
# Use `all` to subscribe to all state_instruments up to the max ticker cap.
BLOCKSIZE_STATE_CACHE_MODE=configured
BLOCKSIZE_STATE_CACHE_MAX_TICKERS=250
BLOCKSIZE_STREAM_CACHE_TTL_SECONDS=3600
BLOCKSIZE_STREAM_CACHE_RECONNECT_SECONDS=5

# --- x402 Payment — Solana (Primary) ---
# Your Solana wallet address to receive USDC payments
X402_SOLANA_WALLET_ADDRESS=YourSolanaWalletAddressHere

# Solana mainnet CAIP-2 identifier
X402_SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# USDC SPL Token address on Solana mainnet
X402_SOLANA_USDC_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- x402 Payment — Base L2 (Fallback) ---
# Your EVM wallet address to receive USDC on Base
X402_EVM_WALLET_ADDRESS=0xYourBaseWalletAddressHere

# Base mainnet CAIP-2 identifier
X402_BASE_NETWORK=eip155:8453

# USDC on Base mainnet
X402_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# --- Facilitator ---
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Chain RPC ---
# Use your own production RPC endpoints. Do not commit API-key URLs.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# --- RWA Growth Pilot (candidate monitoring only; never auto-promotes) ---
RWA_GROWTH_PILOT_ENABLED=false
RWA_GROWTH_PILOT_INTERVAL_SECONDS=1800
RWA_GROWTH_PILOT_INITIAL_DELAY_SECONDS=15
RWA_GROWTH_PILOT_TIMEOUT_SECONDS=20
RWA_GROWTH_PILOT_HISTORY_PATH=/data/rwa_growth_pilot_history.jsonl
RWA_GROWTH_PILOT_STATUS_PATH=/data/rwa_growth_pilot_status.json
RWA_GROWTH_PILOT_ALIGNMENT_HISTORY_PATH=/data/rwa_growth_pilot_alignment_history.jsonl
RWA_GROWTH_PILOT_ALIGNMENT_STATUS_PATH=/data/rwa_growth_pilot_alignment_latest.json
RWA_GROWTH_PILOT_DEPTH_HISTORY_PATH=/data/rwa_growth_pilot_depth_history.jsonl
RWA_GROWTH_PILOT_DEPTH_STATUS_PATH=/data/rwa_growth_pilot_depth_latest.json
RWA_GROWTH_PILOT_PROMOTION_HISTORY_PATH=/data/rwa_growth_pilot_promotion_history.jsonl
RWA_GROWTH_PILOT_PROMOTION_STATUS_PATH=/data/rwa_growth_pilot_promotion_latest.json
RWA_EVM_RPC_MIN_INTERVAL_SECONDS=0.09
RWA_EVM_RPC_RETRY_ATTEMPTS=4
# Primary authenticated RPCs for the Ethereum/Base pilot lanes.
EVM_RPC_ETHEREUM_URL=
EVM_RPC_BASE_URL=
# Optional comma-separated authenticated fallbacks, tried before public RPCs.
EVM_RPC_ETHEREUM_URLS=
EVM_RPC_BASE_URLS=
# Set true only when every required chain has redundant configured RPCs.
RWA_EVM_DISABLE_PUBLIC_RPC_FALLBACKS=false

# Reject proofs older than this many seconds. Set 0 only for controlled tests.
X402_PAYMENT_MAX_AGE_SECONDS=900

# Keep false in production. True only accepts mock_ or test_ proofs for local demos.
X402_ALLOW_MOCK_PAYMENTS=false

# --- Tiered Pricing (USDC per call) ---
# Discovery tools:          FREE
PRICE_CORE_CRYPTO=0.002
PRICE_EXTENDED_CRYPTO=0.004
PRICE_TRADFI=0.005
PRICE_EQUITIES=0.008
PRICE_ANALYTICS=0.008

# --- Server Configuration ---
RESOURCE_SERVER_PORT=8402
MCP_TRANSPORT=stdio
MCP_SERVER_PORT=8403
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1
CORS_ALLOW_ORIGINS=https://mcp.blocksize.info,https://claude.ai,http://localhost:8402,http://127.0.0.1:8402
MAX_BATCH_SIZE=20
DISCOVERY_RATE_LIMIT_ENABLED=true
DISCOVERY_RATE_LIMIT_PER_MINUTE=60
DISCOVERY_RATE_LIMIT_PER_DAY=1000
TRIAL_IP_HASH_SALT=change-me-to-a-long-random-secret

# --- Anthropic-safe MCP beta ---
# Mounts at /anthropic/mcp on the FastAPI resource server.
ANTHROPIC_ONLY_MODE=false
# Some clients, including Claude custom connectors, may fall back to root OAuth
# metadata even when connecting to a path-scoped MCP URL. Keep this set to
# anthropic on the shared production host; use cursor only on a Cursor-only host.
ROOT_OAUTH_CONNECTOR=anthropic
ANTHROPIC_DAILY_CREDITS=50
ANTHROPIC_ENTITLEMENT_DB_PATH=anthropic_entitlements.db
ANTHROPIC_MCP_PUBLIC_URL=https://mcp.blocksize.info/anthropic/mcp

# Use "none" for local development, or "clerk", "auth0", or "supabase" for OAuth.
ANTHROPIC_AUTH_PROVIDER=none
ANTHROPIC_ENABLE_BETA_TOKENS=false
ANTHROPIC_OAUTH_REDIRECT_PATH=/auth/callback
# Use a stable secret and persistent directory in production so Claude OAuth
# sessions survive deploys/restarts. Example on Railway: /data/anthropic_oauth.
ANTHROPIC_OAUTH_JWT_SIGNING_KEY=
ANTHROPIC_OAUTH_STORAGE_DIR=
ANTHROPIC_OAUTH_STORAGE_ENCRYPTION_KEY=
ANTHROPIC_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*
ANTHROPIC_OAUTH_SCOPES=openid,email,profile

# Development/beta bearer-token map. Use only random secret tokens in real deployments.
ANTHROPIC_BETA_TOKENS='{"replace-with-random-token":{"user_id":"beta-user","email":"beta@example.com"}}'

# --- Cursor MCP connector ---
# Cursor uses its own entitlement settings so Claude storage changes do not move
# the Cursor daily-credit ledger.
CURSOR_DAILY_CREDITS=50
CURSOR_ENTITLEMENT_DB_PATH=anthropic_entitlements.db
CURSOR_MCP_PUBLIC_URL=https://mcp.blocksize.info/cursor/mcp
CURSOR_AUTH_PROVIDER=none
CURSOR_ENABLE_BETA_TOKENS=false
CURSOR_OAUTH_REDIRECT_PATH=/auth/callback
CURSOR_OAUTH_JWT_SIGNING_KEY=
CURSOR_OAUTH_STORAGE_DIR=
CURSOR_OAUTH_STORAGE_ENCRYPTION_KEY=
CURSOR_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,cursor://*
CURSOR_OAUTH_SCOPES=email,profile
CURSOR_BETA_TOKENS=

# Clerk OAuth option
CLERK_DOMAIN=
CLERK_CLIENT_ID=
CLERK_CLIENT_SECRET=

# Auth0 OAuth option
AUTH0_CONFIG_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Supabase OAuth option
SUPABASE_PROJECT_URL=
